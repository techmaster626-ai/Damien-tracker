rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.email == 'vicario.d83@gmail.com' ||
         request.auth.uid == 'admin_vicario_super');
    }

    function isCoach() {
      return isAuthenticated() && 
        (isAdmin() || 
         request.auth.token.role == 'coach' || 
         request.auth.token.email.matches('.*@damienhs\\.edu'));
    }

    function isValidMatchPayload() {
      return request.resource.data.keys().hasAll(['id', 'homeTeam', 'awayTeam', 'currentQuarter', 'events']) &&
             request.resource.data.homeTeam.name is string &&
             request.resource.data.awayTeam.name is string &&
             request.resource.data.currentQuarter is int &&
             request.resource.data.currentQuarter >= 1 &&
             request.resource.data.currentQuarter <= 10 &&
             request.resource.data.events is list &&
             request.resource.data.events.size() <= 2000;
    }

    // Match Documents Collection
    // Read: Public / Spectators / Players / Parents can view live scoreboards and shot charts
    // Write / Update: Coaches and Admins can create and score matches
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isCoach() || isAdmin() || (isAuthenticated() && isValidMatchPayload());
      allow update: if isCoach() || isAdmin() || (isAuthenticated() && isValidMatchPayload());
      allow delete: if isAdmin();
    }

    // User Profiles & Roles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
  }
}
