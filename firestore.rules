rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: matches
// Document ID: {matchId} (string, 6-40 chars)
// Fields:
//   - id: string (required, 4-64 chars) - Unique match identifier
//   - title: string (required, 2-100 chars) - Match Title (e.g. "USA vs Hungary")
//   - tournament: string (optional, 0-100 chars) - Tournament name
//   - location: string (optional, 0-100 chars) - Pool location
//   - date: string (optional, 8-30 chars) - Date of match
//   - ruleSet: string (optional, 2-30 chars) - Ruleset (WorldAquatics, NCAA, etc.)
//   - quarterLengthSec: number (required, 60-1200) - Quarter length in seconds
//   - shotClockSec: number (required, 10-60) - Shot clock length in seconds
//   - exclusionSec: number (required, 10-60) - Exclusion duration in seconds
//   - currentQuarter: number (required, 1-10) - Current period/quarter
//   - clockSec: number (required, 0-1200) - Clock remaining seconds
//   - isFinal: bool (optional) - Match completed flag
//   - homeTeam: map (required) - Home team details & roster
//   - awayTeam: map (required) - Away team details & roster
//   - events: list (optional, max 500 items) - Chronological event logs
//   - uid: string (optional, 1-128 chars) - Creator user UID
//   - updatedAt: timestamp or string (optional) - Last update time
//   - lastSavedBy: string (optional, 1-64 chars) - Client identifier
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        !('uid' in resource.data) || request.auth.uid == resource.data.uid
      );
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.uid == 'anonymous_user';
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredMatchFields() {
      return request.resource.data.keys().hasAll([
        'id', 'title', 'quarterLengthSec', 'shotClockSec',
        'exclusionSec', 'currentQuarter', 'clockSec', 'homeTeam', 'awayTeam'
      ]);
    }

    function isValidTeam(teamMap) {
      return teamMap is map &&
        teamMap.keys().hasAll(['name', 'score', 'roster']) &&
        teamMap.name is string && teamMap.name.size() <= 80 &&
        teamMap.score is number && teamMap.score >= 0 && teamMap.score <= 100 &&
        teamMap.roster is list && teamMap.roster.size() <= 30;
    }

    function isValidMatch(data) {
      return hasRequiredMatchFields() &&
        data.id is string && data.id.size() >= 3 && data.id.size() <= 64 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.quarterLengthSec is number && data.quarterLengthSec >= 60 && data.quarterLengthSec <= 1200 &&
        data.shotClockSec is number && data.shotClockSec >= 10 && data.shotClockSec <= 60 &&
        data.exclusionSec is number && data.exclusionSec >= 10 && data.exclusionSec <= 60 &&
        data.currentQuarter is number && data.currentQuarter >= 1 && data.currentQuarter <= 10 &&
        data.clockSec is number && data.clockSec >= 0 && data.clockSec <= 1200 &&
        isValidTeam(data.homeTeam) &&
        isValidTeam(data.awayTeam) &&
        (!('events' in data) || (data.events is list && data.events.size() <= 500));
    }

    // ===============================================================
    // Matches Collection Rules
    // ===============================================================

    match /matches/{matchId} {
      // Allow read for live spectator scoreboards & broadcast overlay
      allow read: if true;

      // Allow create with valid match schema
      allow create: if isValidMatch(request.resource.data) && uidUnchanged();

      // Allow update with valid match schema and protected ownership
      allow update: if isValidMatch(request.resource.data) && uidNotModified();

      // Allow delete for document owner
      allow delete: if isDocOwner() || isAuthenticated();
    }
  }
}
